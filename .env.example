# Copie para .env e preencha. O .env nunca entra no repositorio.

# --- Modelos -----------------------------------------------------------------
# Chave direta da TypeSafe (System One). Opcional se voce rodar o Jev via OpenRouter.
TYPESAFE_API_KEY=

# Chave do OpenRouter. E por aqui que rodam os baselines e, de preferencia,
# tambem o Jev: preco de uma fonte so deixa a comparacao justa.
OPENROUTER_API_KEY=

# --- Modelo local ------------------------------------------------------------
# O Laya roda nesta maquina e nao precisa de chave nenhuma. Um token do Hugging
# Face e opcional e serve so para nao esbarrar no limite de download anonimo ao
# baixar os pesos pela primeira vez.
HF_TOKEN=

# --- Observabilidade (opcional, nunca obrigatoria para rodar) ----------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Anonimizador ------------------------------------------------------------
# Salt do pseudonimo deterministico (HMAC-SHA256). Nunca entra no repositorio.
# Por documento e o padrao; global so com decisao explicita. Ver docs/anonimizacao.md.
ANONIMIZADOR_SALT=
ANONIMIZADOR_ESCOPO_SALT=documento
